            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"postman-provider\",\n  \"externalTransactionId\": \"insufficient-{{runId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"postman-round\",\n  \"gameId\": \"postman-game\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"150.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
