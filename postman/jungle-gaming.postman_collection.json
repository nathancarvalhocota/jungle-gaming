      ]
    },
    {
      "name": "01 - Operações financeiras",
      "description": "Execute em ordem. Os IDs e chaves são gerados pelo primeiro pedido da collection.",
      "item": [
        {
          "name": "01 - BET processada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{betKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"postman-provider\",\n  \"externalTransactionId\": \"bet-{{runId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"postman-round\",\n  \"gameId\": \"postman-game\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"10.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/wagering/transactions",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"BET processada\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"betTransactionId\", body.transactionId);",
                  "pm.expect(body.status).to.eql(\"PROCESSED\");",
                  "pm.expect(body.balance.amount).to.eql(\"90.00\");"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Replay idempotente da BET",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{betKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"postman-provider\",\n  \"externalTransactionId\": \"bet-{{runId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"postman-round\",\n  \"gameId\": \"postman-game\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"10.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/wagering/transactions",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Replay retorna resultado original\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.idempotentReplay).to.eql(true);",
                  "pm.expect(body.transactionId).to.eql(pm.collectionVariables.get(\"betTransactionId\"));",
                  "pm.expect(body.balance.amount).to.eql(\"90.00\");"
                ]
              }
            }
          ]
        },
