        {
          "name": "10 - BET sem saldo suficiente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "insufficient-key-{{runId}}"
