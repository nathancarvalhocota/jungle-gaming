{
  "info": {
    "name": "Jungle Gaming - API HTTP",
    "description": "Collection para exercitar as funcionalidades HTTP implementadas no jungle-gaming. Rode os pedidos na ordem usando Collection Runner, começando por 00 - Preparar execução. A collection gera identificadores únicos por execução e valida os status e resultados esperados. Não cobre SQS, inbox, publicação da outbox, workers de referências, retry ou DLQ.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "zeroPlayerId",
      "value": ""
    },
    {
      "key": "walletId",
      "value": ""
    },
    {
      "key": "zeroWalletId",
      "value": ""
    },
    {
      "key": "betTransactionId",
      "value": ""
    },
    {
      "key": "winTransactionId",
      "value": ""
    },
    {
      "key": "lossTransactionId",
      "value": ""
    },
    {
      "key": "pendingTransactionId",
      "value": ""
    },
    {
      "key": "refundTransactionId",
      "value": ""
    },
    {
      "key": "rollbackTransactionId",
      "value": ""
    },
    {
      "key": "betKey",
      "value": ""
    },
    {
      "key": "refundKey",
      "value": ""
    },
    {
      "key": "rollbackKey",
      "value": ""
    },
    {
      "key": "ledgerCursor",
      "value": ""
    },
    {
      "key": "ledgerCursor2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Ambiente e Wallet",
      "item": [
        {
          "name": "00 - Preparar execução e verificar liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "pm.collectionVariables.set(\"playerId\", \"postman-\" + runId);",
                  "pm.collectionVariables.set(\"zeroPlayerId\", \"postman-zero-\" + runId);",
                  "pm.collectionVariables.set(\"walletId\", \"\");",
                  "pm.collectionVariables.set(\"zeroWalletId\", \"\");",
                  "pm.collectionVariables.set(\"betTransactionId\", \"\");",
                  "pm.collectionVariables.set(\"winTransactionId\", \"\");",
                  "pm.collectionVariables.set(\"lossTransactionId\", \"\");",
                  "pm.collectionVariables.set(\"pendingTransactionId\", \"\");",
                  "pm.collectionVariables.set(\"refundTransactionId\", \"\");",
                  "pm.collectionVariables.set(\"rollbackTransactionId\", \"\");",
                  "pm.collectionVariables.set(\"ledgerCursor\", \"\");",
                  "pm.collectionVariables.set(\"ledgerCursor2\", \"\");",
                  "pm.collectionVariables.set(\"betKey\", \"bet-key-\" + runId);",
                  "pm.collectionVariables.set(\"refundKey\", \"refund-key-\" + runId);",
                  "pm.collectionVariables.set(\"rollbackKey\", \"rollback-key-\" + runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Liveness responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().status).to.eql(\"ok\");"
                ]
              }
            }
          ]
        },
        {
          "name": "01 - Criar Wallet com saldo zero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{zeroPlayerId}}\",\n  \"initialBalance\": { \"amount\": \"0.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/wallets",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Wallet zero criada\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"zeroWalletId\", body.id);",
                  "pm.expect(body.balance.amount).to.eql(\"0.00\");"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Consultar Wallet zero",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallets/{{zeroWalletId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Wallet zero consultada\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Confirmar ledger vazio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallets/{{zeroWalletId}}/ledger",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Ledger vazio\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.items).to.have.length(0);",
                  "pm.expect(body.nextCursor).to.eql(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Criar Wallet com abertura auditável",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": { \"amount\": \"100.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/wallets",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Wallet criada com saldo inicial\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"walletId\", body.id);",
                  "pm.expect(body.balance.amount).to.eql(\"100.00\");"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Verificar unicidade de jogador e moeda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
